#--------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your machine.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# XAMPP: project folder inside C:\xampp\htdocs\ (see README)
app.baseURL = 'http://localhost/vetclinic/public/'

# MySQL / MariaDB (XAMPP defaults: user root, empty password)
database.default.hostname = localhost
database.default.database = vetclinic_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# AI features (optional). Leave blank to use the built-in rule-based fallback.
ANTHROPIC_API_KEY =
ANTHROPIC_MODEL = claude-opus-5-5
